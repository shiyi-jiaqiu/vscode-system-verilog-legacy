diff --git a/include/util/IncludePaths.h b/include/util/IncludePaths.h
new file mode 100644
index 0000000..636c038
--- /dev/null
+++ b/include/util/IncludePaths.h
@@ -0,0 +1,47 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+
+#include <filesystem>
+#include <span>
+#include <string_view>
+#include <vector>
+
+namespace server {
+inline std::filesystem::path includeIdentity(const std::filesystem::path& path) {
+    std::error_code ec;
+    auto canonical = std::filesystem::weakly_canonical(path, ec);
+    return ec ? std::filesystem::absolute(path).lexically_normal() : canonical;
+}
+
+/// Lookup candidates through the first existing file, including absent higher-priority
+/// paths. Keeping those paths lets creation/deletion invalidate just actual searchers.
+inline std::vector<std::filesystem::path> includeCandidates(
+    const std::filesystem::path& parent, std::string_view name, bool system,
+    std::span<const std::filesystem::path> userDirs,
+    std::span<const std::filesystem::path> systemDirs,
+    std::span<const std::filesystem::path> additionalDirs,
+    bool disableLocal, bool incDirFirst,
+    std::span<const std::filesystem::path> libraryDirs = {}) {
+    namespace fs = std::filesystem;
+    if (name.empty()) return {};
+    const fs::path spelling(name);
+    std::vector<fs::path> dirs;
+    if (spelling.is_absolute()) dirs.emplace_back();
+    else if (system) dirs.assign(systemDirs.begin(), systemDirs.end());
+    else {
+        if (!disableLocal && !incDirFirst) dirs.push_back(parent.parent_path());
+        dirs.insert(dirs.end(), additionalDirs.begin(), additionalDirs.end());
+        dirs.insert(dirs.end(), libraryDirs.begin(), libraryDirs.end());
+        dirs.insert(dirs.end(), userDirs.begin(), userDirs.end());
+        if (!disableLocal && incDirFirst) dirs.push_back(parent.parent_path());
+    }
+    std::vector<fs::path> result;
+    for (const auto& dir : dirs) {
+        auto candidate = includeIdentity(dir / spelling);
+        result.push_back(candidate);
+        std::error_code ec;
+        if (fs::is_regular_file(candidate, ec)) break;
+    }
+    return result;
+}
+} // namespace server
