+void SourceManager::invalidatePath(const fs::path& path) {
+    std::error_code ec;
+    auto normalized = disableProximatePaths ? path : fs::weakly_canonical(path, ec);
+    if (ec)
+        normalized = fs::absolute(path).lexically_normal();
+    std::unique_lock<std::shared_mutex> lock(mutex);
+    auto it = lookupCache.find(getU8Str(normalized));
+    if (it != lookupCache.end()) {
