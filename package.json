{
  "name": "verilog-systemverilog-legacy",
  "displayName": "Verilog/SystemVerilog Legacy",
  "description": "Ctags-based Verilog/SystemVerilog indexing, hovers with parameter and macro values, semantic highlighting and project linting, for VS Code 1.84",
  "version": "0.6.5",
  "publisher": "local",
  "keywords": [
    "verilog",
    "system verilog",
    "systemverilog",
    "fpga",
    "slang"
  ],
  "homepage": "https://github.com/shiyi-jiaqiu/vscode-system-verilog-legacy",
  "repository": {
    "type": "git",
    "url": "https://github.com/shiyi-jiaqiu/vscode-system-verilog-legacy.git"
  },
  "bugs": {
    "url": "https://github.com/shiyi-jiaqiu/vscode-system-verilog-legacy/issues"
  },
  "engines": {
    "vscode": "^1.84.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Linters",
    "Formatters"
  ],
  "icon": "images/icon.png",
  "main": "./dist/main.js",
  "activationEvents": [
    "workspaceContains:**/*.{v,sv,vh,svh}"
  ],
  "prettier": {
    "trailingComma": "es5",
    "singleQuote": true,
    "printWidth": 100,
    "semi": false
  },
  "eslintConfig": {
    "root": true,
    "parser": "@typescript-eslint/parser",
    "parserOptions": {
      "ecmaVersion": 6,
      "sourceType": "module"
    },
    "plugins": [
      "@typescript-eslint",
      "unused-imports"
    ],
    "rules": {
      "@typescript-eslint/naming-convention": [
        "error",
        {
          "selector": "enumMember",
          "format": [
            "PascalCase"
          ]
        }
      ],
      "@typescript-eslint/semi": "off",
      "curly": "warn",
      "eqeqeq": "warn",
      "no-throw-literal": "warn",
      "semi": "off",
      "no-extra-semi": "error",
      "no-unused-vars": "off",
      "no-undef": "warn",
      "no-constant-condition": "warn",
      "unused-imports/no-unused-imports": "error"
    },
    "ignorePatterns": [
      "out",
      "dist",
      "**/*.d.ts",
      "src/test"
    ],
    "extends": [
      "eslint:recommended",
      "prettier"
    ]
  },
  "contributes": {
    "languages": [
      {
        "id": "verilog",
        "aliases": [
          "Verilog",
          "verilog"
        ],
        "extensions": [
          ".v",
          ".vl"
        ],
        "icon": {
          "light": "./resources/sv_light.svg",
          "dark": "./resources/sv_dark.svg"
        },
        "configuration": "./languages/verilog/verilog.configuration.json"
      },
      {
        "id": "verilogheader",
        "aliases": [
          "Verilog",
          "verilog"
        ],
        "extensions": [
          ".vh"
        ],
        "icon": {
          "light": "./resources/svh_light.svg",
          "dark": "./resources/svh_dark.svg"
        },
        "configuration": "./languages/verilog/verilog.configuration.json"
      },
      {
        "id": "systemverilog",
        "aliases": [
          "System Verilog",
          "systemverilog"
        ],
        "extensions": [
          ".sv"
        ],
        "configuration": "./languages/sv/systemverilog.configuration.json",
        "icon": {
          "light": "./resources/sv_light.svg",
          "dark": "./resources/sv_dark.svg"
        }
      },
      {
        "id": "systemverilogheader",
        "aliases": [
          "systemverilog"
        ],
        "extensions": [
          ".svh"
        ],
        "configuration": "./languages/sv/systemverilog.configuration.json",
        "icon": {
          "light": "./resources/svh_light.svg",
          "dark": "./resources/svh_dark.svg"
        }
      },
      {
        "id": "ucf",
        "aliases": [
          "vivado ucf",
          "ucf constraints"
        ],
        "extensions": [
          ".ucf"
        ],
        "configuration": "./languages/ucf/constraints.configuration.json"
      },
      {
        "id": "sdc",
        "aliases": [
          "Synopsys Design Constraints"
        ],
        "extensions": [
          ".sdc"
        ],
        "configuration": "./languages/sdc/sdc.configuration.json"
      },
      {
        "id": "tcl",
        "aliases": [
          "Tcl",
          "tcl"
        ],
        "extensions": [
          ".tcl",
          "tm",
          "tk"
        ],
        "configuration": "./languages/tcl/tcl.configuration.json"
      },
      {
        "id": "xdc",
        "aliases": [
          "Xilinx Design Constraints"
        ],
        "extensions": [
          ".xdc"
        ],
        "configuration": "./languages/xdc/sdc.configuration.json"
      },
      {
        "id": "dotf",
        "aliases": [
          "Verilog Filelist",
          "verilog-filelist",
          "dotf"
        ],
        "extensions": [
          ".f"
        ],
        "configuration": "./languages/dotf/dotf.configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "verilog",
        "scopeName": "source.verilog",
        "path": "./languages/verilog/verilog.tmLanguage.json"
      },
      {
        "language": "verilogheader",
        "scopeName": "source.systemverilog",
        "path": "./languages/verilog/verilog.tmLanguage.json"
      },
      {
        "language": "systemverilog",
        "scopeName": "source.systemverilog",
        "path": "./languages/sv/systemverilog.tmLanguage.json"
      },
      {
        "language": "systemverilogheader",
        "scopeName": "source.systemverilog",
        "path": "./languages/sv/systemverilog.tmLanguage.json"
      },
      {
        "language": "ucf",
        "scopeName": "source.ucfconstraints",
        "path": "./languages/ucf/ucf.tmLanguage.json"
      },
      {
        "language": "sdc",
        "scopeName": "source.sdc",
        "path": "./languages/sdc/sdc.tmLanguage.json"
      },
      {
        "language": "tcl",
        "scopeName": "source.tcl",
        "path": "./languages/tcl/tcl.tmlanguage.json"
      },
      {
        "language": "xdc",
        "scopeName": "source.sdc",
        "path": "./languages/sdc/sdc.tmLanguage.json"
      },
      {
        "scopeName": "markdown.systemverilog.codeblock",
        "path": "./languages/sv/markdownblock.json",
        "injectTo": [
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.systemverilog": "source.systemverilog"
        }
      },
      {
        "scopeName": "markdown.verilog.codeblock",
        "path": "./languages/verilog/markdownblock.json",
        "injectTo": [
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.verilog": "source.verilog"
        }
      },
      {
        "language": "dotf",
        "scopeName": "source.f",
        "path": "./languages/dotf/dotf.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "verilog",
        "path": "./languages/verilog/verilog.snippets.json"
      },
      {
        "language": "systemverilog",
        "path": "./languages/verilog/verilog.snippets.json"
      },
      {
        "language": "systemverilog",
        "path": "./languages/sv/systemverilog.snippets.json"
      },
      {
        "language": "verilogheader",
        "path": "./languages/verilog/verilog.snippets.json"
      },
      {
        "language": "systemverilogheader",
        "path": "./languages/verilog/verilog.snippets.json"
      },
      {
        "language": "systemverilogheader",
        "path": "./languages/sv/systemverilog.snippets.json"
      }
    ],
    "configuration": {
      "title": "verilog configuration",
      "properties": {
        "verilog.ctags.path": {
          "description": "Path to ctags universal executable",
          "default": "",
          "type": "string"
        },
        "verilog.filelist": {
          "default": "",
          "description": "Project filelist relative to the workspace root. Its sources are indexed, include paths and macros are used by lint and indexing, and changes reload automatically. Set verilog.lint.slang.scope to project to lint all sources.",
          "type": "string"
        },
        "verilog.moduleGlobs": {
          "default": [
            "**/*.{sv,v}"
          ],
          "description": "Without `verilog.filelist`: globs of the module, interface and package files to index",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "verilog.includeGlobs": {
          "default": [
            "**/*.{svh,vh}"
          ],
          "description": "Without `verilog.filelist`: globs of the include files to index",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "verilog.excludeGlob": {
          "default": "",
          "description": "Without `verilog.filelist`: glob of the files the other globs leave out",
          "type": "string"
        },
        "verilog.server.enabled": {
          "default": true,
          "description": "Use slang-server for standard Verilog navigation and diagnostics when available. Falls back to ctags and slang CLI if unavailable.",
          "type": "boolean"
        },
        "verilog.server.path": {
          "default": "",
          "description": "Path to slang-server. Empty searches PATH and the directory containing the configured slang executable. Requires a binary compatible with this operating system.",
          "type": "string"
        },
        "verilog.server.startupTimeout": {
          "default": 15,
          "minimum": 1,
          "maximum": 600,
          "type": "integer",
          "description": "Seconds allowed for the native protocol initialization and include-configuration handshake. Workspace indexing follows the handshake and is not part of this timeout."
        },
        "verilog.lint.slang.args": {
          "default": "",
          "description": "CLI fallback arguments only; native server options belong in .slang/server.json. Examples: `-j 2`, `-Wextra`, `--suppress-warnings ip/**`, `--lint-only`, `--error-limit 100` or `--top name`. Appended after the checkbox options; individual warning flags override warning groups. Do not pass `--diag-json`, which the extension uses to read diagnostics.",
          "type": "string"
        },
        "verilog.lint.slang.path": {
          "description": "Path to the tool",
          "default": "",
          "type": "string"
        },
        "verilog.lint.slang.enabled": {
          "default": true,
          "description": "Enable slang lint diagnostics.",
          "type": "boolean"
        },
        "verilog.lint.slang.scope": {
          "default": "openFiles",
          "enum": [
            "openFiles",
            "project"
          ],
          "enumItemLabels": [
            "Open files",
            "Entire project"
          ],
          "description": "CLI fallback scope. Open files checks .sv/.v editor tabs with filelist include paths and macros. Entire project checks the filelist or top; without either, checks open files. Built-in slang-server always displays diagnostics only for open source tabs.",
          "type": "string"
        },
        "verilog.lint.slang.runOnSave": {
          "default": true,
          "description": "Check when files open and after saves. When off, only the Verilog: Lint command checks.",
          "type": "boolean"
        },
        "verilog.lint.slang.analysis": {
          "default": "local",
          "enum": [
            "local",
            "syntax",
            "full"
          ],
          "enumItemLabels": [
            "Local lint",
            "Syntax only",
            "Full elaboration"
          ],
          "description": "CLI fallback only. Local lint skips full hierarchy elaboration; syntax skips type checking and most warnings; full checks instance-dependent behavior. Built-in slang-server uses native shallow analysis regardless of this setting.",
          "type": "string"
        },
        "verilog.lint.slang.readingMode": {
          "default": true,
          "description": "Group missing includes/macros/packages into an information message and hide dependent undeclared-name errors. Turn off for strict diagnostics, including missing modules. Real name mistakes may also be hidden in files with incomplete dependencies.",
          "type": "boolean"
        },
        "verilog.lint.slang.ignoredDiagnostics": {
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "Diagnostic codes to hide from Problems in both the built-in server and CLI fallback, such as ExpectedMember, ExpectedDeclarator, NotAllowedInCU, ExpectedExpression, ExpectedIdentifier or unknown-sys-name. Exact, case-sensitive matches. Raw Diagnostics retains the original results; parsing and the compiler error limit are unchanged.",
          "type": "array"
        },
        "verilog.lint.slang.threads": {
          "default": 1,
          "minimum": 1,
          "type": "integer",
          "description": "Threads per slang process. One reduces peak resource use. Checks run one process at a time; additional arguments can override this with -j."
        },
        "verilog.lint.slang.reportMissingModules": {
          "default": false,
          "description": "Also report unknown modules, interfaces and programs in reading mode. Strict mode always reports them. Local lint does not check the full instance hierarchy.",
          "type": "boolean"
        },
        "verilog.lint.slang.warnings.widthTruncation": {
          "default": true,
          "description": "Report expression/port width truncation and lossy constant conversions.",
          "type": "boolean"
        },
        "verilog.lint.slang.warnings.widthExpansion": {
          "default": false,
          "description": "Report implicit expression/port width expansion.",
          "type": "boolean"
        },
        "verilog.lint.slang.warnings.signedness": {
          "default": false,
          "description": "Report implicit signedness conversions and comparisons of differently signed values.",
          "type": "boolean"
        },
        "verilog.lint.slang.warnings.portConnections": {
          "default": true,
          "description": "Report unconnected ports and explicitly empty input/inout connections.",
          "type": "boolean"
        },
        "verilog.lint.slang.warnings.implicitNets": {
          "default": true,
          "description": "Report implicitly declared wires, which can indicate misspelled signal names.",
          "type": "boolean"
        },
        "verilog.lint.slang.warnings.caseStatements": {
          "default": true,
          "description": "Report missing case defaults, duplicate/overlapping items and incomplete coverage.",
          "type": "boolean"
        },
        "verilog.lint.slang.warnings.unused": {
          "default": false,
          "description": "Report unused or undriven signals, ports, parameters and other declarations.",
          "type": "boolean"
        },
        "verilog.format.args": {
          "default": "",
          "description": "verible-verilog-format arguments, such as `--indentation_spaces=4`",
          "type": "string"
        },
        "verilog.format.path": {
          "description": "Path to the tool",
          "default": "",
          "type": "string"
        }
      }
    },
    "commands": [
      {
        "command": "verilog.server.configureIndex",
        "title": "Verilog: Configure Native Index"
      },
      {
        "command": "verilog.server.autoConfigure",
        "title": "Verilog: Auto-configure Native Index and Includes"
      },
      {
        "command": "verilog.server.showDiagnostics",
        "title": "Verilog: Show Raw Diagnostics"
      },
      {
        "command": "verilog.lint.run",
        "title": "Verilog: Lint"
      },
      {
        "command": "verilog.project.instancesView.copyHierarchyPath",
        "title": "Copy Path",
        "inlineContext": [
          "Instance"
        ],
        "icon": {
          "light": "./resources/light/files.svg",
          "dark": "./resources/dark/files.svg"
        }
      },
      {
        "command": "verilog.project.setTopLevel",
        "title": "Set Top Level",
        "shortTitle": "Set Top",
        "languages": [
          "verilog",
          "systemverilog"
        ],
        "icon": "$(chip)"
      },
      {
        "command": "verilog.project.setInstanceByFile",
        "title": "Select Instance",
        "icon": "$(symbol-class)",
        "languages": [
          "verilog",
          "systemverilog"
        ]
      },
      {
        "command": "verilog.project.clearTopLevel",
        "title": "Clear Top Level",
        "icon": "$(panel-close)"
      },
      {
        "command": "verilog.project.selectTopLevel",
        "title": "Select Top Level",
        "icon": "$(folder-opened)"
      },
      {
        "command": "verilog.project.setInstanceByPathInternal",
        "title": "Set Instance",
        "icon": "$(inspect)"
      },
      {
        "command": "verilog.project.setInstanceByPath",
        "title": "Verilog: Set Instance"
      },
      {
        "command": "verilog.project.setInstance",
        "title": "Set Instance from Instance View",
        "hidden": true
      },
      {
        "command": "verilog.project.toggleParams",
        "title": "Toggle Params",
        "icon": "$(symbol-type-parameter)"
      },
      {
        "command": "verilog.project.toggleData",
        "title": "Toggle Data",
        "icon": "$(symbol-variable)"
      },
      {
        "command": "verilog.project.showSourceFile",
        "title": "Show Module",
        "inlineContext": [
          "Module"
        ],
        "icon": {
          "light": "./resources/light/go-to-file.svg",
          "dark": "./resources/dark/go-to-file.svg"
        }
      },
      {
        "command": "verilog.project.copyHierarchyPath",
        "title": "Copy Path",
        "inlineContext": [],
        "icon": {
          "light": "./resources/light/files.svg",
          "dark": "./resources/dark/files.svg"
        }
      },
      {
        "command": "verilog.reindex",
        "title": "Verilog: Reindex"
      },
      {
        "command": "verilog.fixModules",
        "title": "Verilog: Fix file names to match module names"
      },
      {
        "command": "extdev.updateConfig",
        "title": "Extdev: update config (package.json and CONFIG.md)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "verilog",
          "title": "Verilog",
          "icon": "$(chip)"
        }
      ],
      "panel": []
    },
    "views": {
      "verilog": [
        {
          "id": "verilog.project",
          "name": "Hierarchy",
          "when": "!verilog.slangExtensionActive"
        },
        {
          "id": "verilog.project.instancesView",
          "name": "Instances",
          "when": "!verilog.slangExtensionActive"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "verilog.project",
        "contents": "[Select top level](command:verilog.project.selectTopLevel)"
      },
      {
        "view": "verilog.project.instancesView",
        "contents": "[Select top level](command:verilog.project.selectTopLevel)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "verilog.project.clearTopLevel",
          "group": "navigation",
          "when": "view == verilog.project"
        },
        {
          "command": "verilog.project.selectTopLevel",
          "group": "navigation",
          "when": "view == verilog.project"
        },
        {
          "command": "verilog.project.setInstanceByPathInternal",
          "group": "navigation",
          "when": "view == verilog.project"
        },
        {
          "command": "verilog.project.toggleParams",
          "group": "navigation",
          "when": "view == verilog.project"
        },
        {
          "command": "verilog.project.toggleData",
          "group": "navigation",
          "when": "view == verilog.project"
        }
      ],
      "view/item/context": [
        {
          "command": "verilog.project.showSourceFile",
          "group": "inline",
          "when": "view == verilog.project && viewItem == Module"
        },
        {
          "command": "verilog.project.copyHierarchyPath",
          "group": "inline",
          "when": "view == verilog.project"
        },
        {
          "command": "verilog.project.instancesView.copyHierarchyPath",
          "group": "inline",
          "when": "view == verilog.project.instancesView && viewItem == Instance"
        }
      ],
      "editor/title": [
        {
          "command": "verilog.project.setTopLevel",
          "when": "resourceLangId == verilog || resourceLangId == systemverilog",
          "group": "navigation"
        },
        {
          "command": "verilog.project.setInstanceByFile",
          "when": "resourceLangId == verilog || resourceLangId == systemverilog",
          "group": "navigation"
        }
      ]
    },
    "semanticTokenTypes": [
      {
        "id": "port",
        "superType": "parameter",
        "description": "Module or interface port"
      },
      {
        "id": "instance",
        "superType": "variable",
        "description": "Module or interface instance"
      }
    ]
  },
  "scripts": {
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "lint": "eslint src --ext ts",
    "vscode:prepublish": "npm run esbuild-base -- --minify",
    "esbuild-base": "esbuild ./src/extension.ts --bundle --external:vscode --format=cjs --platform=node --outfile=dist/main.js --alias:jsonc-parser=jsonc-parser/lib/esm/main.js",
    "esbuild": "npm run esbuild-base -- --sourcemap",
    "esbuild-watch": "npm run esbuild -- --watch",
    "format": "npx prettier --write **/*.ts",
    "test-compile": "tsc -p ./",
    "test-headless": "npm run esbuild && npm run compile-tests && xvfb-run -a node ./out/src/test/runTest.js",
    "test": "npm run esbuild && npm run compile-tests && node ./out/src/test/runTest.js",
    "compile": "tsc -p ./",
    "package": "vsce package --no-dependencies",
    "watch": "tsc -w -p ./",
    "syntax": "js-yaml ./languages/sv/systemverilog.tmLanguage.yaml >./languages/sv/systemverilog.tmLanguage.json",
    "pretest": "npm run compile-tests && npm run compile && npm run lint"
  },
  "dependencies": {
    "@types/deep-diff": "^1.0.5",
    "js-yaml": "^4.1.0",
    "jsonc-parser": "3.2.1",
    "semver": "^7.6.0",
    "vscode-languageclient": "9.0.1",
    "which": "^4.0.0"
  },
  "devDependencies": {
    "@types/antlr4": "4.11.6",
    "@types/glob": "^8.1.0",
    "@types/mocha": "~10.0.6",
    "@types/node": "~20.11.30",
    "@types/vscode": "^1.75.0",
    "@types/which": "^3.0.3",
    "@typescript-eslint/eslint-plugin": "^7.3.1",
    "@typescript-eslint/parser": "^7.3.1",
    "@vscode/test-electron": "^2.3.9",
    "@vscode/vsce": "~2.24.0",
    "antlr4ts-cli": "0.5.0-alpha.4",
    "deep-diff": "^1.0.2",
    "esbuild": "^0.20.2",
    "eslint": "8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "2.29.1",
    "eslint-plugin-n": "16.6.2",
    "eslint-plugin-promise": "6.1.1",
    "eslint-plugin-unused-imports": "^3.1.0",
    "glob": "^7.1.1",
    "mocha": "^10.3.0",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.3"
  },
  "__metadata": {
    "id": "feb7e3b5-7d35-4f95-a3d2-61eeaa12efa5",
    "publisherDisplayName": "AndrewNolte",
    "publisherId": "fcf32c99-a624-437b-9f47-9333ea128623"
  }
}
