#!/usr/bin/env python3
"""Create an initial HDL filelist and configure a single-folder VS Code workspace."""

# Runs on Python 2.7 as well, the only Python of a stock CentOS 7.
from __future__ import print_function

import argparse
import io
import json
import os
import re
import sys


SOURCE_SUFFIXES = {".v", ".vl", ".sv"}
HEADER_SUFFIXES = {".vh", ".svh"}
FILELIST = ".vscode/hdl.f"
INCLUDE_RE = re.compile(r'^[ \t]*`include[ \t]+"([^"]+)"', re.M)
PACKAGE_RE = re.compile(r"^[ \t]*package[ \t]+\w+", re.M)


def read_text(path):
    with io.open(path, encoding="utf-8", errors="replace") as f:
        return f.read()


def write_text(path, text):
    with io.open(path, "w", encoding="utf-8") as f:
        f.write(text if isinstance(text, type(u"")) else text.decode("utf-8"))


def tokens(text):
    result = []
    i = 0
    while i < len(text):
        if text[i].isspace():
            i += 1
        elif text.startswith("//", i):
            end = text.find("\n", i + 2)
            i = len(text) if end < 0 else end
        elif text.startswith("/*", i):
            end = text.find("*/", i + 2)
            if end < 0:
                raise ValueError("unterminated comment in settings.json")
            i = end + 2
        elif text[i] == '"':
            start = i
            i += 1
            while i < len(text):
                if text[i] == "\\":
                    i += 2
                elif text[i] == '"':
                    i += 1
                    break
                else:
                    i += 1
            else:
                raise ValueError("unterminated string in settings.json")
            result.append(("string", json.loads(text[start:i]), start, i))
        elif text[i] in "{}[]:,":
            result.append((text[i], text[i], i, i + 1))
            i += 1
        else:
            start = i
            while i < len(text) and not text[i].isspace() and text[i] not in '{}[]:,"':
                if text.startswith("//", i) or text.startswith("/*", i):
                    break
                i += 1
            result.append(("atom", text[start:i], start, i))
    return result


def update_settings(text, values):
    items = tokens(text)
    if len(items) < 2 or items[0][0] != "{" or items[-1][0] != "}":
        raise ValueError("settings.json must contain one top-level object")

    depths = []
    stack = []
    for kind, _, _, _ in items:
        depths.append(len(stack))
        if kind in ("{", "["):
            stack.append(kind)
        elif kind in ("}", "]"):
            if not stack or (stack.pop(), kind) not in (("{", "}"), ("[", "]")):
                raise ValueError("unbalanced brackets in settings.json")
    if stack:
        raise ValueError("unbalanced brackets in settings.json")

    edits = []
    missing = dict(values)
    for i, (kind, name, _, _) in enumerate(items[:-2]):
        if depths[i] != 1 or kind != "string" or name not in values or items[i + 1][0] != ":":
            continue
        if name not in missing:
            raise ValueError("duplicate setting: " + name)
        start_index = i + 2
        end_index = start_index
        while end_index < len(items) and not (depths[end_index] == 1 and items[end_index][0] in (",", "}")):
            end_index += 1
        if end_index == start_index:
            raise ValueError("missing value for setting: " + name)
        edits.append((items[start_index][2], items[end_index - 1][3], json.dumps(values[name])))
        del missing[name]

    if missing:
        before_close = items[-2][0]
        separator = "" if before_close in ("{", ",") else ","
        lines = ["  " + json.dumps(key) + ": " + json.dumps(value) for key, value in missing.items()]
        edits.append((items[-1][2], items[-1][2], separator + "\n" + ",\n".join(lines) + "\n"))

    for start, end, replacement in sorted(edits, reverse=True):
        text = text[:start] + replacement + text[end:]
    return text


def quoted_path(path):
    if any(char in path for char in ('"', "\\", "$", "#", "\n", "\r")):
        raise ValueError("unsupported character in HDL path: " + path)
    return '"' + path + '"'


def make_filelist(root):
    """Lists the sources, with the include directories their `include lines need.

    A file named by an `include is not listed as a source, whatever its suffix, since
    compiling it on its own repeats or breaks its contents. Packages come first, as
    some tools need a package compiled before its users.
    """
    texts = {}
    sources = []
    for directory, subdirs, names in os.walk(root):
        subdirs[:] = sorted(name for name in subdirs if name not in (".git", ".vscode"))
        for name in sorted(names):
            path = os.path.join(directory, name)
            suffix = os.path.splitext(name)[1].lower()
            if suffix in SOURCE_SUFFIXES or suffix in HEADER_SUFFIXES:
                texts[path] = read_text(path)
                if suffix in SOURCE_SUFFIXES:
                    sources.append(path)
    if not sources:
        raise ValueError("no .v, .vl or .sv source files found in " + root)

    included = set()
    incdirs = set()
    unresolved = set()
    for path in sorted(texts):
        for name in INCLUDE_RE.findall(texts[path]):
            sibling = os.path.normpath(os.path.join(os.path.dirname(path), name))
            if sibling in texts:
                found = [(sibling, os.path.dirname(path))]
            else:
                # `include "common/regs.svh" needs the directory above common/
                suffix = os.sep + os.path.normpath(name)
                found = [(f, f[: -len(suffix)]) for f in texts if f.endswith(suffix)]
            if not found:
                unresolved.add(name)
            for header, incdir in found:
                included.add(header)
                incdirs.add(incdir)

    sources = [path for path in sources if path not in included]
    sources.sort(key=lambda path: (PACKAGE_RE.search(texts[path]) is None, path))

    def relative(path):
        return quoted_path(os.path.relpath(path, root).replace(os.sep, "/"))

    lines = ["# Initial HDL inventory; edit source selection, include paths and macros as needed."]
    lines += ["-I " + relative(item) for item in sorted(incdirs)]
    lines += [relative(item) for item in sources]
    if unresolved:
        print("Includes not found in the workspace: " + ", ".join(sorted(unresolved)))
    return "\n".join(lines) + "\n", len(sources)


def main(argv):
    parser = argparse.ArgumentParser(description="Set up a single-folder HDL workspace")
    parser.add_argument("workspace")
    split = argv.index("--") if "--" in argv else len(argv)
    before = argv[:split]
    lint_args = argv[split + 1:] if split < len(argv) else None
    args = parser.parse_args(before)
    root = os.path.realpath(args.workspace)
    if not os.path.isdir(root):
        parser.error("workspace is not a directory: " + root)

    settings_path = os.path.join(root, ".vscode", "settings.json")
    filelist_path = os.path.join(root, FILELIST)
    filelist = None
    count = None
    if os.path.exists(filelist_path) and not os.path.isfile(filelist_path):
        raise ValueError("filelist path is not a file: " + filelist_path)
    if not os.path.exists(filelist_path):
        filelist, count = make_filelist(root)
    values = {
        "verilog.filelist": FILELIST,
        "verilog.ctags.path": "ctags",
        "verilog.lint.slang.enabled": True,
        "verilog.lint.slang.path": "slang",
    }
    if lint_args is not None:
        values["verilog.lint.slang.args"] = " ".join(lint_args)
    exists = os.path.exists(settings_path)
    existing = read_text(settings_path) if exists else u"{}\n"
    settings = update_settings(existing, values)

    if not os.path.isdir(os.path.dirname(settings_path)):
        os.mkdir(os.path.dirname(settings_path))
    if filelist is not None:
        write_text(filelist_path, filelist)
        print("Created " + filelist_path + " with " + str(count) + " source files")
    else:
        print("Kept existing " + filelist_path)
    if settings != existing or not exists:
        write_text(settings_path, settings)
    print("Configured " + settings_path)
    print("Review the filelist, then run 'Verilog: Reindex' in VS Code.")


if __name__ == "__main__":
    try:
        main(sys.argv[1:])
    except (OSError, ValueError) as error:
        print("hdl-setup: " + str(error), file=sys.stderr)
        sys.exit(1)
